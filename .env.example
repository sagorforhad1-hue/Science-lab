# Copy this template to .env.local for local credentials.
# Never paste keys into chat or put them in public/ or dist/.
# Local values are NOT automatically synced to Vercel.

# 1. Groq - console.groq.com/keys (server only)
GROQ_API_KEY=

# 2. Resend - resend.com/api-keys (server only)
RESEND_API_KEY=
# A sender on your verified domain, e.g. Science Lab <notices@yourdomain.com>
RESEND_FROM_EMAIL=

# 3. Firebase Cloud Messaging - console.firebase.google.com
# Project settings > General > Your web app > SDK configuration
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# Project settings > Cloud Messaging > Web Push certificates > Public key
FIREBASE_VAPID_KEY=
# Project settings > Service accounts > Firebase Admin SDK (server only)
FIREBASE_CLIENT_EMAIL=
# Keep the whole private_key value in double quotes, with literal \n line breaks.
FIREBASE_PRIVATE_KEY=""

# Provider credentials are consumed only by authenticated server adapters.

# Server only: never expose in frontend
SUPABASE_SERVICE_ROLE_KEY=

# Optional model override
GROQ_MODEL=openai/gpt-oss-20b

# WhatsApp Cloud API: add later, then enable in Super Admin
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=
# The approved template must contain one body text parameter: {{1}}.
